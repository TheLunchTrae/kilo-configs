{
  "$schema": "https://app.kilo.ai/config.json",
  // Replace these pins only after the Kilo packages are published. See .kilo/AGENTS.md for current limits.
  "plugin": [
    ["@lunchbox-labs/opencode-model-profiles@0.2.0", { "configFile": "../kilo/models.jsonc" }],
    "@lunchbox-labs/opencode-prompt-composer@0.2.4"
  ],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 1,
  // Direct providers do not get the native websearch tool by default.
  "web_search": true,
  "references": {
    "agent-references": {
      "path": "~/.config/kilo/references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "goal": "ask",
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git *--output*": "ask",
      "git *>*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "sudo*": "ask",
      "python*": "ask",
      "git branch -D*": "deny",
      "git branch * -D *": "deny",
      "git clean *": "deny",
      "git clean -n*": "ask",
      "git clean --dry-run*": "ask",
      "git clean -dn *": "ask",
      "git clean -fdn *": "ask",
      "git clean -xdn *": "ask",
      "git clean -d -n *": "ask",
      "git clean -d --dry-run *": "ask",
      "git clean *--no-*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "git push *--mirror*": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -fR*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "rm -R -f*": "deny",
      "rm -f -R*": "deny",
      "rm --recursive --force*": "deny",
      "rm --force --recursive*": "deny",
      "rm -r --force*": "deny",
      "rm --force -r*": "deny",
      "rm -R --force*": "deny",
      "rm --force -R*": "deny",
      "rm --recursive -f*": "deny",
      "rm -f --recursive*": "deny",
      "rm * -rf*": "deny",
      "rm * -fr*": "deny",
      "rm * -r -f*": "deny",
      "rm * -f -r*": "deny"
    },
    // Do not add a global wildcard edit denial. Kilo applies it as a ceiling that blocks native plan files,
    // and Task children of the native code agent inherit it. Read-only agents carry their own edit denial.
    "task": {
      "*": "deny"
    },
    "project_script": "ask",
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    // agents/code.md supplies the prompt and permissions of the native code agent.
    "plan": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "debug": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    // Kilo deprecates this mode. The code agent owns delegation.
    "orchestrator": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": "allow",
        "agent_manager": "deny"
      }
    },
    "explore": {
      "color": "#8AEEF7",
      "permission": {
        "agent_manager": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": "ask"
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": "ask"
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": "ask"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
