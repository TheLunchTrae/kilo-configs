{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": ["@lunchbox-labs/kilo-model-profiles@^0.3.1", "@lunchbox-labs/kilo-prompt-composer@^0.3.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 1,
  "web_search": true,
  "references": {
    "agent-references": {
      "path": "~/.config/kilo/references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "goal": "ask",
    "read": {
      "*/secrets": "deny",
      "*/secrets/*": "deny",
      "secrets": "deny",
      "secrets/*": "deny"
    },
    "bash": {
      "basename *": "allow",
      "bun run *": "allow",
      "bun test *": "allow",
      "cksum *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "command -v*": "allow",
      "composer exec *": "allow",
      "composer run *": "allow",
      "composer run-script *": "allow",
      "dirname *": "allow",
      "dotnet --help *": "allow",
      "dotnet --info *": "allow",
      "dotnet --list-runtimes *": "allow",
      "dotnet --list-sdks *": "allow",
      "dotnet --version *": "allow",
      "dotnet add *": "allow",
      "dotnet build *": "allow",
      "dotnet clean *": "allow",
      "dotnet format *": "allow",
      "dotnet help *": "allow",
      "dotnet list *": "allow",
      "dotnet msbuild *": "allow",
      "dotnet new *": "allow",
      "dotnet new install *": "ask",
      "dotnet new uninstall *": "ask",
      "dotnet new update *": "ask",
      "dotnet nuget list *": "allow",
      "dotnet nuget verify *": "allow",
      "dotnet nuget why *": "allow",
      "dotnet pack *": "allow",
      "dotnet package add *": "allow",
      "dotnet package download *": "allow",
      "dotnet package list *": "allow",
      "dotnet package remove *": "allow",
      "dotnet package search *": "allow",
      "dotnet package update *": "allow",
      "dotnet project convert *": "allow",
      "dotnet publish *": "allow",
      "dotnet reference *": "allow",
      "dotnet remove *": "allow",
      "dotnet restore *": "allow",
      "dotnet run *": "allow",
      "dotnet sdk check *": "allow",
      "dotnet sln *": "allow",
      "dotnet test *": "allow",
      "dotnet tool list *": "allow",
      "dotnet tool restore *": "allow",
      "dotnet tool run *": "allow",
      "dotnet tool search *": "allow",
      "dotnet vstest *": "allow",
      "dotnet watch *": "allow",
      "dotnet workload list *": "allow",
      "dotnet workload search *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh search *": "allow",
      "git blame *": "allow",
      "git branch *": "allow",
      "git cat-file *": "allow",
      "git describe *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-remote *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git name-rev *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git shortlog *": "allow",
      "git show *": "allow",
      "git stash list *": "allow",
      "git status *": "allow",
      "go build *": "allow",
      "go fmt *": "allow",
      "go run *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "npm run *": "allow",
      "npm start *": "allow",
      "npm test *": "allow",
      "pnpm *": "allow",
      "printf *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "stat *": "allow",
      "yarn run *": "allow",
      "ack *": "deny",
      "ag *": "deny",
      "awk *": "deny",
      "cat *": "deny",
      "curl *": "deny",
      "dir *": "deny",
      "egrep *": "deny",
      "fd *": "deny",
      "fdfind *": "deny",
      "fgrep *": "deny",
      "find *": "deny",
      "findstr *": "deny",
      "gawk *": "deny",
      "gh pr merge *": "deny",
      "gh repo delete *": "deny",
      "git -C * branch * -D *": "deny",
      "git -C * branch -D *": "deny",
      "git branch * -D *": "deny",
      "git branch -D *": "deny",
      "git clean *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git grep *": "deny",
      "git reset --hard*": "deny",
      "glob *": "deny",
      "grep *": "deny",
      "kubectl delete *": "deny",
      "less *": "deny",
      "ls *": "deny",
      "mawk *": "deny",
      "npm publish *": "deny",
      "npm unpublish *": "deny",
      "pnpm publish *": "deny",
      "rg *": "deny",
      "rm -fr*": "deny",
      "rm -rf*": "deny",
      "sed *": "deny",
      "Select-String *": "deny",
      "tee *": "deny",
      "touch *": "deny",
      "tree *": "deny",
      "wget *": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    "code": {
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "task": {
          "code-reviewer": "allow",
          "explore": "allow",
          "general": "allow",
          "planner": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "ask": {
      "disable": true
    },
    "debug": {
      "disable": true
    },
    "orchestrator": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "agent_manager": "deny"
      }
    },
    "explore": {
      "color": "#8AEEF7",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "agent_manager": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
