{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": ["@lunchbox-labs/kilo-model-profiles@^0.3.1", "@lunchbox-labs/kilo-prompt-composer@^0.3.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 1,
  "web_search": true,
  "references": {
    "agent-references": {
      "path": "~/.config/kilo/references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "goal": "ask",
    "read": {
      "*/secrets": "deny",
      "*/secrets/*": "deny",
      "secrets": "deny",
      "secrets/*": "deny"
    },
    "bash": {
      "basename *": "allow",
      "bun --help *": "allow",
      "bun --version *": "allow",
      "bun add *": "allow",
      "bun audit *": "allow",
