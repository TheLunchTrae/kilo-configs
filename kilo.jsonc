{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "goal": "ask",
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      // Keep Kilo's default ask. Built-in helper allows include head, tail, wc, sort, cut, and jq.
      "printf *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "stat *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "cksum *": "allow",
      "command -v*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git merge-base*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git ls-remote*": "allow",
      "git shortlog*": "allow",
      "git describe*": "allow",
      "git cat-file*": "allow",
      "git name-rev*": "allow",
      "git stash list*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh search*": "allow",
      // Use the dedicated read, grep, glob, edit, and webfetch tools for these operations.
      "cat *": "deny",
      "less *": "deny",
      "ls *": "deny",
      "dir *": "deny",
      "tree *": "deny",
      "find *": "deny",
      "fd *": "deny",
      "fdfind *": "deny",
      "glob *": "deny",
      "grep *": "deny",
      "egrep *": "deny",
      "fgrep *": "deny",
      "rg *": "deny",
      "ag *": "deny",
      "ack *": "deny",
      "git grep*": "deny",
      "findstr *": "deny",
      "Select-String *": "deny",
      "touch *": "deny",
      "sed *": "deny",
      "awk *": "deny",
      "gawk *": "deny",
      "mawk *": "deny",
      "tee *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "gh pr merge*": "deny",
      "gh repo delete*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "npm unpublish*": "deny",
      "kubectl delete*": "deny"
    },
    // Edits ask unless an agent sets its own rule. Do not change this to a global denial: Task children
    // of the native code agent inherit denials, which would remove the edit tools of general.
    // Give every new agent an explicit edit object. Read-only agents need "*": "deny".
    "edit": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  }
}
