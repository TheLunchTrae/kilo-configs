{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": ["@lunchbox-labs/kilo-model-profiles@^0.3.1", "@lunchbox-labs/kilo-prompt-composer@^0.3.0"],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 1,
  "web_search": true,
  "references": {
    "agent-references": {
      "path": "~/.config/kilo/references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "goal": "ask",
    "read": {
      "*/secrets": "deny",
      "*/secrets/*": "deny",
      "secrets": "deny",
      "secrets/*": "deny"
    },
    "bash": {
      "basename *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "cargo *": "allow",
      "cksum *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "command -v*": "allow",
      "composer *": "allow",
      "dirname *": "allow",
      "dotnet --help *": "allow",
      "dotnet --info *": "allow",
      "dotnet --list-runtimes *": "allow",
      "dotnet --list-sdks *": "allow",
      "dotnet --version *": "allow",
      "dotnet add *": "allow",
      "dotnet build *": "allow",
      "dotnet clean *": "allow",
      "dotnet format *": "allow",
      "dotnet help *": "allow",
      "dotnet list *": "allow",
      "dotnet msbuild *": "allow",
      "dotnet new *": "allow",
      "dotnet new -*": "ask",
      "dotnet new --help": "allow",
      "dotnet new -h": "allow",
      "dotnet new install *": "ask",
      "dotnet new uninstall *": "ask",
      "dotnet new update *": "ask",
      "dotnet nuget list *": "allow",
      "dotnet nuget verify *": "allow",
      "dotnet nuget why *": "allow",
      "dotnet pack *": "allow",
      "dotnet package add *": "allow",
      "dotnet package download *": "allow",
      "dotnet package list *": "allow",
      "dotnet package remove *": "allow",
      "dotnet package search *": "allow",
      "dotnet package update *": "allow",
      "dotnet project convert *": "allow",
      "dotnet publish *": "allow",
      "dotnet reference *": "allow",
      "dotnet remove *": "allow",
      "dotnet restore *": "allow",
      "dotnet run *": "allow",
      "dotnet sdk check *": "allow",
      "dotnet sln *": "allow",
      "dotnet test *": "allow",
      "dotnet tool list *": "allow",
      "dotnet tool restore *": "allow",
      "dotnet tool run *": "allow",
      "dotnet tool search *": "allow",
      "dotnet vstest *": "allow",
      "dotnet watch *": "allow",
      "dotnet workload list *": "allow",
      "dotnet workload search *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh search *": "allow",
      "git --no-pager blame *": "allow",
      "git --no-pager branch *": "allow",
      "git --no-pager cat-file *": "allow",
      "git --no-pager describe *": "allow",
      "git --no-pager diff *": "allow",
      "git --no-pager log *": "allow",
      "git --no-pager ls-files *": "allow",
      "git --no-pager ls-remote *": "allow",
      "git --no-pager ls-tree *": "allow",
      "git --no-pager merge-base *": "allow",
      "git --no-pager name-rev *": "allow",
      "git --no-pager rev-list *": "allow",
      "git --no-pager rev-parse *": "allow",
      "git --no-pager shortlog *": "allow",
      "git --no-pager show *": "allow",
      "git --no-pager stash list *": "allow",
      "git --no-pager status *": "allow",
      "git blame *": "allow",
      "git branch *": "allow",
      "git cat-file *": "allow",
      "git describe *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-remote *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git name-rev *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git shortlog *": "allow",
      "git show *": "allow",
      "git stash list *": "allow",
      "git status *": "allow",
      "go build *": "allow",
      "go fmt *": "allow",
      "go run *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "mise --help *": "allow",
      "mise --version *": "allow",
      "mise config ls *": "allow",
      "mise doctor *": "allow",
      "mise exec *": "allow",
      "mise fmt *": "allow",
      "mise help *": "allow",
      "mise install *": "allow",
      "mise latest *": "allow",
      "mise list *": "allow",
      "mise lock *": "allow",
      "mise ls *": "allow",
      "mise ls-remote *": "allow",
      "mise outdated *": "allow",
      "mise plugins ls *": "allow",
      "mise plugins ls-remote *": "allow",
      "mise r *": "allow",
      "mise registry *": "allow",
      "mise run *": "allow",
      "mise tasks": "allow",
      "mise tasks deps *": "allow",
      "mise tasks info *": "allow",
      "mise tasks ls *": "allow",
      "mise tasks validate *": "allow",
      "mise tool *": "allow",
      "mise use *": "allow",
      "mise version *": "allow",
      "mise watch *": "allow",
      "mise where *": "allow",
      "mise which *": "allow",
      "mise x *": "allow",
      "node --experimental-strip-types --test *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "printf *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      "stat *": "allow",
      "yarn run *": "allow",
      "bun -*": "ask",
      "bun --help": "allow",
      "bun --version": "allow",
      "bun *--global*": "ask",
      "bun * -g*": "ask",
      "bun link *": "ask",
      "bun pm cache *": "ask",
      "bun pm version *": "ask",
      "bun unlink *": "ask",
      "bun upgrade *": "ask",
      "cargo +*": "ask",
      "cargo -*": "ask",
      "cargo --help": "allow",
      "cargo --list": "allow",
      "cargo --version": "allow",
      "cargo install *": "ask",
      "cargo login *": "ask",
      "cargo logout *": "ask",
      "cargo owner *": "ask",
      "cargo uninstall *": "ask",
      "composer -*": "ask",
      "composer --help": "allow",
      "composer --version": "allow",
      "composer cc *": "ask",
      "composer clear*": "ask",
      "composer config *": "ask",
      "composer global *": "ask",
      "composer self*": "ask",
      "mise fmt *-a*": "ask",
      "mise use *--global*": "ask",
      "mise use -g*": "ask",
      "mise use * -g*": "ask",
      "mise use *--override*": "ask",
      "npm -*": "ask",
      "npm --help": "allow",
      "npm --version": "allow",
      "npm *--global*": "ask",
      "npm * -g*": "ask",
      "npm *--location*global*": "ask",
      "npm access *": "ask",
      "npm add-user *": "ask",
      "npm adduser *": "ask",
      "npm author *": "ask",
      "npm cache *": "ask",
      "npm c *": "ask",
      "npm config *": "ask",
      "npm deprecate *": "ask",
      "npm dist-tag *": "ask",
      "npm get *": "ask",
      "npm link *": "ask",
      "npm login *": "ask",
      "npm logout *": "ask",
      "npm org *": "ask",
      "npm owner *": "ask",
      "npm profile *": "ask",
      "npm set *": "ask",
      "npm star *": "ask",
      "npm team *": "ask",
      "npm token *": "ask",
      "npm undeprecate *": "ask",
      "npm unlink *": "ask",
      "npm unstar *": "ask",
      "npm version ?*": "ask",
      "pnpm *--global*": "ask",
      "pnpm -g*": "ask",
      "pnpm * -g*": "ask",
      "pnpm *--config.global*": "ask",
      "pnpm *--location*global*": "ask",
      "ack *": "deny",
      "ag *": "deny",
      "awk *": "deny",
      "bun publish *": "deny",
      "cargo publish *": "deny",
      "cargo yank *": "deny",
      "cat *": "deny",
      "curl *": "deny",
      "dir *": "deny",
      "egrep *": "deny",
      "fd *": "deny",
      "fdfind *": "deny",
      "fgrep *": "deny",
      "find *": "deny",
      "findstr *": "deny",
      "gawk *": "deny",
      "gh pr merge *": "deny",
      "gh repo delete *": "deny",
      "git --no-pager branch * -D *": "deny",
      "git --no-pager branch -D *": "deny",
      "git -C * branch * -D *": "deny",
      "git -C * branch -D *": "deny",
      "git branch * -D *": "deny",
      "git branch -D *": "deny",
      "git clean *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git grep *": "deny",
      "git reset --hard*": "deny",
      "glob *": "deny",
      "grep *": "deny",
      "kubectl delete *": "deny",
      "less *": "deny",
      "ls *": "deny",
      "mawk *": "deny",
      "npm pu*": "deny",
      "npm unp*": "deny",
      "pnpm publish *": "deny",
      "rg *": "deny",
      "rm -fr*": "deny",
      "rm -rf*": "deny",
      "sed *": "deny",
      "Select-String *": "deny",
      "tee *": "deny",
      "touch *": "deny",
      "tree *": "deny",
      "wget *": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    "code": {
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "task": {
          "code-reviewer": "allow",
          "explore": "allow",
          "general": "allow",
          "planner": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "ask": {
      "disable": true
    },
    "debug": {
      "disable": true
    },
    "orchestrator": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "agent_manager": "deny"
      }
    },
    "explore": {
      "color": "#8AEEF7",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "agent_manager": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
