    "edit": {
      "*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    "code": {
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "task": {
          "code-reviewer": "allow",
          "explore": "allow",
          "general": "allow",
          "planner": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "ask": {
      "disable": true
    },
    "debug": {
      "disable": true
    },
    "orchestrator": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "agent_manager": "deny"
      }
    },
    "explore": {
      "color": "#8AEEF7",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "agent_manager": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": {
          "*": "ask"
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
