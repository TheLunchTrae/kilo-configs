{
  "$schema": "https://app.kilo.ai/config.json",
  // Replace these pins only after the Kilo packages are published. See .kilo/AGENTS.md for current limits.
  "plugin": [
    ["@lunchbox-labs/opencode-model-profiles@0.2.0", { "configFile": "../kilo/models.jsonc" }],
    "@lunchbox-labs/opencode-prompt-composer@0.2.4"
  ],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "disabled_providers": ["opencode"],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-luna",
  "subagent_depth": 1,
  // Direct providers do not get the native websearch tool by default.
  "web_search": true,
  "references": {
    "agent-references": {
      "path": "~/.config/kilo/references/agent",
      "description": "Conditional coding, testing, verification, delegation, documentation, and task guidance.",
      "hidden": true
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "goal": "ask",
    "read": {
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git -* push*": "ask",
      "gh pr merge*": "ask",
      "gh repo edit*": "ask",
      "sudo *": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "npm unpublish*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -fR*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "rm -R -f*": "deny",
      "rm -f -R*": "deny",
      "rm --recursive --force*": "deny",
      "rm --force --recursive*": "deny",
      "rm -r --force*": "deny",
      "rm --force -r*": "deny",
      "rm -R --force*": "deny",
      "rm --force -R*": "deny",
      "rm --recursive -f*": "deny",
      "rm -f --recursive*": "deny",
      "rm -*rf*": "deny",
      "rm -*fr*": "deny",
      "rm -*Rf*": "deny",
      "rm -*fR*": "deny",
      "rm * -rf*": "deny",
      "rm * -fr*": "deny",
      "rm * -Rf*": "deny",
      "rm * -fR*": "deny",
      "rm * -r -f*": "deny",
      "rm * -f -r*": "deny",
      "rm * --recursive*": "deny",
      "rm -r * -f*": "deny",
      "rm -R * -f*": "deny",
      "rm -f * -r*": "deny",
      "rm -f * -R*": "deny",
      "rm -*f* -*r*": "deny",
      "rm -*f* -*R*": "deny",
      "rm -*r* -*f*": "deny",
      "rm -*R* -*f*": "deny",
      "*rm -rf*": "deny",
      "*rm -fr*": "deny",
      "*rm -Rf*": "deny",
      "*rm -fR*": "deny",
      "xargs *rm -*r*": "deny",
      "find * -delete*": "deny",
      "find * -exec rm *": "deny",
      "find * -execdir rm *": "deny",
      "sh": "deny",
      "bash": "deny",
      "sh -s*": "deny",
      "bash -s*": "deny",
      "sh -": "deny",
      "bash -": "deny",
      "sh -x": "deny",
      "zsh": "deny",
      "bash -x": "deny",
      "zsh -": "deny",
      "python -": "deny",
      "python3 -": "deny",
      "node -": "deny",
      "*sh -c *$(curl*": "deny",
      "*sh <(curl*": "deny",
      "*sh -c *$(wget*": "deny",
      "*sh <(wget*": "deny",
      "*bash -c *$(curl*": "deny",
      "*bash <(curl*": "deny",
      "*bash -c *$(wget*": "deny",
      "*bash <(wget*": "deny",
      "shred *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "wipefs*": "deny",
      "fdisk*": "deny",
      "parted*": "deny",
      "diskpart*": "deny",
      "chmod -R*": "deny",
      "chown -R*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "*Remove-Item*-Recurse*": "deny",
      "*rmdir /s*": "deny",
      "*rmdir /S*": "deny",
      "*Format-Volume*": "deny",
      "*Clear-Disk*": "deny",
      "git branch -D*": "deny",
      "git branch * -D *": "deny",
      "git branch *--delete*--force*": "deny",
      "git branch *--force*--delete*": "deny",
      "git branch *-d -f*": "deny",
      "git branch *-f -d*": "deny",
      "git clean *": "deny",
      "git clean -n*": "allow",
      "git clean --dry-run*": "allow",
      "git clean -dn *": "allow",
      "git clean -fdn *": "allow",
      "git clean -xdn *": "allow",
      "git clean -d -n *": "allow",
      "git clean -d --dry-run *": "allow",
      "git clean *--no-*": "deny",
      "git checkout *-- *": "deny",
      "git checkout .*": "deny",
      "git checkout -f*": "deny",
      "git checkout * -f*": "deny",
      "git checkout *--force*": "deny",
      "git restore *": "deny",
      "git restore --staged *": "allow",
      "git restore -S *": "allow",
      "git restore *--worktree*": "deny",
      "git restore -*W*": "deny",
      "git restore * -*W*": "deny",
      "git switch -f*": "deny",
      "git switch * -f*": "deny",
      "git switch *--discard-changes*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "git reset --merge*": "deny",
      "git reset --keep*": "deny",
      "git worktree remove -f*": "deny",
      "git worktree remove * -f*": "deny",
      "git worktree remove *--force*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git reflog expire*": "deny",
      "git reflog delete*": "deny",
      "git gc *--prune*": "deny",
      "git prune*": "deny",
      "git update-ref -d*": "deny",
      "git update-ref * -d*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "git push *--mirror*": "deny",
      "git push -d*": "deny",
      "git push * -d *": "deny",
      "git push *--delete*": "deny",
      "git push * :*": "deny",
      "git -* push --force*": "deny",
      "git -* push *--force*": "deny",
      "git -* push -f*": "deny",
      "git -* push * -f*": "deny",
      "git -* push * +*": "deny",
      "git -* push *--mirror*": "deny",
      "git -* push *--delete*": "deny",
      "git -* push * -d *": "deny",
      "git -* push * :*": "deny",
      "git -* reset *--hard*": "deny",
      "git -* clean *": "deny",
      "git -* clean -n*": "allow",
      "git -* clean --dry-run*": "allow",
      "git -* clean -dn *": "allow",
      "git -* clean -fdn *": "allow",
      "git -* clean -xdn *": "allow",
      "git -* clean -d -n *": "allow",
      "git -* clean -d --dry-run *": "allow",
      "git -* clean *--no-*": "deny",
      "git -* checkout *-- *": "deny",
      "git -* checkout .*": "deny",
      "git -* restore *": "deny",
      "git -* restore --staged *": "allow",
      "git -* restore -S *": "allow",
      "git -* restore *--worktree*": "deny",
      "git -* restore -*W*": "deny",
      "git -* restore * -*W*": "deny",
      "git -* stash drop*": "deny",
      "git -* stash clear*": "deny",
      "git -* branch -D*": "deny",
      "git -* branch * -D *": "deny",
      "git -* filter-branch*": "deny",
      "git -* filter-repo*": "deny",
      "git -* reflog expire*": "deny",
      "git -* gc *--prune*": "deny",
      "gh repo delete*": "deny",
      "gh api *DELETE*": "deny",
      "gh release delete*": "deny",
      "gh secret delete*": "deny",
      "gh variable delete*": "deny",
      "gh label delete*": "deny",
      "gh run delete*": "deny",
      "gh cache delete*": "deny",
      "gh issue delete*": "deny",
      "gh gist delete*": "deny",
      "gh project delete*": "deny",
      "gh codespace delete*": "deny",
      "gh ssh-key delete*": "deny",
      "gh gpg-key delete*": "deny",
      "gh api *-X delete*": "deny",
      "gh api *--method delete*": "deny",
      "*prisma migrate reset*": "deny",
      "*prisma db push *--force-reset*": "deny",
      "*doctrine:database:drop*": "deny",
      "*doctrine:schema:drop*": "deny",
      "dotnet ef database drop*": "deny",
      "*orm:schema-tool:drop*": "deny",
      "dropdb *": "deny",
      "*mysql *drop database*": "deny",
      "*mysql *DROP DATABASE*": "deny",
      "*mysql *Drop Database*": "deny",
      "*psql *drop database*": "deny",
      "*psql *DROP DATABASE*": "deny",
      "*psql *Drop Database*": "deny",
      "*psql *DROP SCHEMA*": "deny",
      "*psql *drop schema*": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "docker volume rm*": "deny",
      "docker compose down *-v*": "deny",
      "docker-compose down *-v*": "deny",
      "docker compose * down *-v*": "deny",
      "docker-compose * down *-v*": "deny",
      "kubectl delete*": "deny",
      "kubectl * delete *": "deny",
      "helm uninstall*": "deny",
      "helm * uninstall*": "deny",
      "helm delete*": "deny",
      "helm * delete *": "deny"
    },
    // Edits ask unless an agent sets its own rule. Do not change this to a global denial: Task children
    // of the native code agent inherit denials, which would remove the edit tools of general.
    // Give every new agent an explicit edit rule. Read-only agents need edit: deny.
    "edit": "ask",
    "task": {
      "*": "deny"
    },
    "project_script": "allow",
    "agent_manager": "ask",
    "github_*": "ask",
    "playwright_*": "ask"
  },
  "agent": {
    // agents/code.md supplies the prompt and permissions of the native code agent, the default primary agent.
    // Native plan mode is the only other primary agent. It writes a plan file and hands it off to code.
    // The code agent answers questions and debugs, so ask and debug stay disabled.
    "plan": {
      "permission": {
        "task": {
          "explore": "allow"
        }
      }
    },
    "ask": {
      "disable": true
    },
    "debug": {
      "disable": true
    },
    "orchestrator": {
      "disable": true
    },
    "general": {
      "color": "#8AF793",
      "permission": {
        "edit": "allow",
        "agent_manager": "deny"
      }
    },
    "explore": {
      "color": "#8AEEF7",
      // Kilo applies global rules after the native explore deny-all, so the global edit ask would reach it.
      // Global project_script allows, and native explore re-adds only global denials, so deny it here.
      "permission": {
        "edit": "deny",
        "project_script": "deny",
        "agent_manager": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": "ask"
      }
    },
    "compaction": {
      "options": {
        "reasoningEffort": "medium"
      },
      "permission": {
        "edit": "ask"
      }
    },
    "title": {
      "options": {
        "reasoningEffort": "low"
      },
      "permission": {
        "edit": "ask"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".idea/**"]
  }
}
